<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Calculator" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/calc_button_equals</item>
        <item name="colorPrimaryVariant">#005A9E</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:statusBarColor">@color/calc_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/calc_background</item>
    </style>

    <style name="CalcButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="cornerRadius">4dp</item>
        <item name="elevation">1dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/calc_border</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">0dp</item>
    </style>

    <style name="CalcButton.Digit" parent="CalcButton">
        <item name="backgroundTint">@color/calc_button_digit</item>
        <item name="android:textColor">@color/calc_button_digit_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="CalcButton.Operator" parent="CalcButton">
        <item name="backgroundTint">@color/calc_button_op</item>
        <item name="android:textColor">@color/calc_button_text</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="CalcButton.Equals" parent="CalcButton">
        <item name="backgroundTint">@color/calc_button_equals</item>
        <item name="android:textColor">@color/calc_button_equals_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="CalcMemoryButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:textColor">@color/calc_button_text</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">2dp</item>
    </style>
</resources>
